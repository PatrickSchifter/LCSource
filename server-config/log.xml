<?xml version="1.0" encoding="UTF-8"?>
<!-- log4cxx 1.x version of Server Source/log.xml: DailyRollingFileAppender was
     replaced by RollingFileAppender + TimeBasedRollingPolicy. -->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

<appender name="DATE_LOGFILE" class="org.apache.log4j.rolling.RollingFileAppender">
	<param name="Append" value="true" />
	<rollingPolicy class="org.apache.log4j.rolling.TimeBasedRollingPolicy">
		<param name="FileNamePattern" value="../LogFiles/${logfile}.%d{yyyy-MM-dd}.log" />
	</rollingPolicy>
	<layout class="org.apache.log4j.PatternLayout">
		<param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%20F : %5L] - %m%n"/>
	</layout>
</appender>

<appender name="DATE_LOGCONSOLE" class="org.apache.log4j.ConsoleAppender">
	<layout class="org.apache.log4j.PatternLayout">
		<param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p - %m%n"/>
	</layout>
</appender>

<root>
	<priority value="trace"/>
	<appender-ref ref="DATE_LOGFILE"/>
	<appender-ref ref="DATE_LOGCONSOLE"/>
</root>

</log4j:configuration>
